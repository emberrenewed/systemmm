    {
      "name": "2. Tickets",
      "item": [
        {
          "name": "List Tickets",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    var list = json.data || [];",
                  "    if (list.length > 0) {",
                  "        pm.collectionVariables.set('ticket_id', String(list[0].id));",
                  "        console.log('ticket_id saved: ' + list[0].id);",
                  "        list.forEach(function (t) {",
                  "            console.log('ticket_id=' + t.id + ' | user_id=' + t.user_id + ' | ' + t.status + ' | ' + t.subject);",
                  "        });",
                  "    } else {",
                  "        console.log('No tickets. Run Create Ticket, or: php artisan migrate:fresh --seed');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tickets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets"
              ]
            },
            "description": "Get tickets for the current {{token}}.\nUser sees only own tickets.\nAdmin sees all tickets."
          },
          "response": []
        },
        {
          "name": "List Tickets with Filter",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tickets?status=open&priority=high",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "open",
                  "description": "open, in_progress, resolved, closed"
                },
                {
                  "key": "priority",
                  "value": "high",
                  "description": "low, medium, high"
                }
              ]
            },
            "description": "Filter tickets.\nstatus and priority are optional.\nNeeds token."
          },
          "response": []
        },
        {
          "name": "Create Ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.id) {",
                  "        pm.collectionVariables.set('ticket_id', String(json.data.id));",
                  "        console.log('ticket_id saved: ' + json.data.id);",
                  "    }",
                  "    pm.test('new ticket has empty status', function () {",
                  "        pm.expect(json.data.status).to.equal(null);",
                  "    });",
                  "    pm.test('new ticket has empty priority', function () {",
                  "        pm.expect(json.data.priority).to.equal(null);",
                  "    });",
                  "}",
                  "pm.test('ticket created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{user_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "subject",
                  "value": "Cannot access my account",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "I am locked out after too many login attempts.",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/tickets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets"
              ]
            },
            "description": "USER creates a ticket.\nUses {{user_token}} — run Login (User) first.\nSend only subject and description.\nstatus and priority start as null.\nSaves ticket_id automatically."
          },
          "response": []
        },
        {
          "name": "Show Ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    var replies = (json.data && json.data.replies) ? json.data.replies : [];",
                  "    console.log('ticket_id=' + json.data.id + ' replies=' + replies.length);",
                  "    replies.forEach(function (r) {",
                  "        var who = (r.user && r.user.is_admin) ? 'ADMIN' : 'USER';",
                  "        console.log('reply #' + r.id + ' [' + who + '] image_url=' + (r.image_url || '(none)') + ' | ' + r.message);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tickets/{{ticket_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets",
                "{{ticket_id}}"
              ],
              "variable": []
            },
            "description": "Show one ticket with all replies.\nEach reply includes image and image_url when an image was uploaded.\nOpen image_url in a browser (needs php artisan storage:link).\nUses {{ticket_id}}."
          },
          "response": []
        },
