{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Teckting API - Basic Test",
    "description": "Simple Postman collection for beginner testing.\n\nHow to test:\n1. Import this collection + environment\n2. Select environment: Teckting Local\n3. Run Login (User) or Login (Admin) first\n4. Then test Tickets and Replies\n\nRoles:\n- Users create, view and update the status of their own tickets\n- Only admin can set the ticket priority (new tickets are always medium)\n- Only admin can add a reply and delete a reply\n- Only admin can delete a ticket\n\nTest accounts (after seed):\n- Admin: admin@test.com / password\n- User: user@test.com / password\n\nLogin and Register auto-save the token.\n\nAll request bodies use form-data (not raw JSON).\nDo not set a Content-Type header, Postman sets it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "ticket_id",
      "value": "1"
    },
    {
      "key": "reply_id",
      "value": "1"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "        console.log('Token saved');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "New User",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "newuser@test.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "password_confirmation",
                  "value": "password",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "Create a new user.\nNo token needed.\nToken is saved automatically after success."
          },
          "response": []
        },
        {
          "name": "Login (User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "        console.log('User token saved');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "email",
                  "value": "user@test.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "password",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Login as normal user.\nEmail: user@test.com\nPassword: password\nBody is form-data.\nToken is saved automatically."
          },
          "response": []
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "        console.log('Admin token saved');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "email",
                  "value": "admin@test.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "password",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Login as admin.\nEmail: admin@test.com\nPassword: password\nToken is saved automatically.\nUse this for delete ticket / add reply / delete reply."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "logout"
              ]
            },
            "description": "Logout current user.\nNeeds token (Bearer)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Tickets",
      "item": [
        {
          "name": "List Tickets",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    var list = json.data || [];",
                  "    if (list.length > 0) {",
                  "        pm.collectionVariables.set('ticket_id', String(list[0].id));",
                  "        console.log('ticket_id saved: ' + list[0].id);",
                  "        list.forEach(function (t) {",
                  "            console.log('ticket_id=' + t.id + ' | user_id=' + t.user_id + ' | ' + t.status + ' | ' + t.subject);",
                  "        });",
                  "    } else {",
                  "        console.log('No tickets found. Run: php artisan migrate:fresh --seed');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tickets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets"
              ]
            },
            "description": "Get all tickets.\nUser sees only own tickets.\nAdmin sees all tickets.\nNeeds token."
          },
          "response": []
        },
        {
          "name": "List Tickets with Filter",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tickets?status=open&priority=high",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "open",
                  "description": "open, in_progress, resolved, closed"
                },
                {
                  "key": "priority",
                  "value": "high",
                  "description": "low, medium, high"
                }
              ]
            },
            "description": "Get tickets with filter.\nstatus and priority are optional.\nNeeds token."
          },
          "response": []
        },
        {
          "name": "Create Ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.id) {",
                  "        pm.collectionVariables.set('ticket_id', String(json.data.id));",
                  "        console.log('ticket_id saved: ' + json.data.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "subject",
                  "value": "Cannot access my account",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "I am locked out after too many login attempts.",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/tickets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets"
              ]
            },
            "description": "Create a new ticket.\nYou cannot send priority. Every new ticket starts as medium.\nOnly an admin can change the priority later.\nSaves ticket_id automatically.\nNeeds token."
          },
          "response": []
        },
        {
          "name": "Show Ticket",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tickets/{{ticket_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets",
                "{{ticket_id}}"
              ],
              "variable": []
            },
            "description": "Show one ticket with replies.\nUses {{ticket_id}}.\nNeeds token."
          },
          "response": []
        },
        {
          "name": "Update Ticket Status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "_method",
                  "value": "PATCH",
                  "type": "text"
                },
                {
                  "key": "status",
                  "value": "resolved",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/tickets/{{ticket_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets",
                "{{ticket_id}}"
              ],
              "variable": []
            },
            "description": "Update the ticket status.\nAllowed: open, in_progress, resolved, closed.\nA user can update their own ticket, an admin can update any ticket.\nBody is form-data, so method is POST with _method=PATCH (Laravel method spoofing).\nNeeds token."
          },
          "response": []
        },
        {
          "name": "Set Ticket Priority (Admin only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "_method",
                  "value": "PATCH",
                  "type": "text"
                },
                {
                  "key": "priority",
                  "value": "high",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/tickets/{{ticket_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets",
                "{{ticket_id}}"
              ],
              "variable": []
            },
            "description": "Set the ticket priority. Admin only.\nAllowed: low, medium, high.\nIf a normal user sends priority it is ignored and nothing changes.\nYou can also send status in the same request.\nBody is form-data, so method is POST with _method=PATCH (Laravel method spoofing).\nNeeds an ADMIN token - run Login (Admin) first."
          },
          "response": []
        },
        {
          "name": "Delete Ticket (Admin only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tickets/{{ticket_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets",
                "{{ticket_id}}"
              ],
              "variable": []
            },
            "description": "Delete a ticket.\nAdmin only.\nLogin as Admin first.\nNeeds token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Replies",
      "item": [
        {
          "name": "Add Reply (Admin only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.id) {",
                  "        pm.collectionVariables.set('reply_id', String(json.data.id));",
                  "        console.log('reply_id saved: ' + json.data.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "message",
                  "value": "We are looking into your issue and will update you soon.",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/tickets/{{ticket_id}}/replies",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tickets",
                "{{ticket_id}}",
                "replies"
              ]
            },
            "description": "Add reply to a ticket.\nAdmin only.\nLogin as Admin first.\nNormal users get 403, even on their own ticket.\nIf ticket status is open, it becomes in_progress.\nSaves reply_id automatically.\nNeeds token."
          },
          "response": []
        },
        {
          "name": "Delete Reply (Admin only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/replies/{{reply_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "replies",
                "{{reply_id}}"
              ]
            },
            "description": "Delete a reply.\nAdmin only.\nLogin as Admin first.\nNeeds token."
          },
          "response": []
        }
      ]
    }
  ]
}
